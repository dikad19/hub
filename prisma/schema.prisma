generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StoreRole {
  OWNER // akses penuh: laporan, harga modal, pengaturan
  STAFF // kasir: jual + lihat stok
}

enum SaleStatus {
  COMPLETED
  VOID
}

enum PaymentMethod {
  CASH
  QRIS
  TRANSFER
  OTHER
  CREDIT // bon / piutang pelanggan
}

enum CashMovementType {
  IN // kas masuk manual (tambah modal, dst.)
  OUT // kas keluar manual (beli es batu, ongkir, dst.)
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum StockCountStatus {
  DRAFT
  COMPLETED
}

enum StockMode {
  NONE    // tidak ada stok (jasa, menu tanpa hitung stok)
  DIRECT  // stok dihitung langsung di varian ini (retail, bahan baku)
  RECIPE  // stok berkurang lewat bahan di resep (menu restoran)
}

enum StockMovementType {
  INITIAL
  PURCHASE
  SALE
  SALE_VOID
  ADJUSTMENT
  RETURN
  CONSUMPTION       // bahan terpakai karena menu terjual
  CONSUMPTION_VOID  // dikembalikan karena penjualan di-void
}

model User {
  id             String          @id
  name           String
  email          String          @unique
  emailVerified  Boolean         @default(false)
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sessions       Session[]
  accounts       Account[]
  memberships    StoreMember[]
  sales          Sale[]          @relation("SaleCashier")
  voidedSales    Sale[]          @relation("SaleVoidedBy")
  stockMovements StockMovement[]
  purchases      Purchase[]
  expenses       Expense[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Store {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  waNumber       String? // opsional, tidak lagi dipakai untuk order
  timezone       String           @default("Asia/Jakarta") // dipakai untuk laporan harian/bulanan
  receiptCounter Int              @default(0)
  returnCounter  Int @default(0)
  salePayments   SalePayment[]
  saleReturns    SaleReturn[]
  plan           String           @default("free")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  members        StoreMember[]
  priceTiers     VariantPriceTier[]
  categories     Category[]
  recipeItems    RecipeItem[]
  products       Product[]
  variants       ProductVariant[]
  suppliers      Supplier[]
  purchases      Purchase[]
  sales          Sale[]
  stockMovements StockMovement[]
  expenses       Expense[]
  variantUnits   ProductVariantUnit[]
  customers      Customer[]
  customerPayments CustomerPayment[]
  cashShifts     CashShift[]
  cashMovements  CashMovement[]
  stockCounts    StockCount[]
  businessType BusinessType @default(RETAIL)
  features     String[]     @default([])
}

model StoreMember {
  id        String    @id @default(cuid())
  userId    String
  storeId   String
  role      StoreRole @default(OWNER)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([storeId])
}

model Category {
  id        String     @id @default(cuid())
  storeId   String
  parentId  String?
  name      String
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  products  Product[]

  @@unique([storeId, parentId, name])
  @@index([storeId, parentId])
}

model Product {
  id          String           @id @default(cuid())
  storeId     String
  categoryId  String?
  name        String
  description String?
  imageUrl    String?
  isActive    Boolean          @default(true) // arsipkan, jangan hapus kalau sudah punya riwayat
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants    ProductVariant[]

  @@index([storeId, isActive])
  @@index([categoryId])
}

model ProductVariant {
  id           String          @id @default(cuid())
  storeId      String // denormalisasi: untuk filter tenant dan unique per toko (harus sama dengan Product.storeId)
  productId    String
  name         String          @default("Standar") // contoh: "Large", "Merah / XL"
  sku          String?
  barcode      String?
  unit         String          @default("pcs") // pcs, kg, liter, ons, bungkus, dst.
  allowDecimal Boolean         @default(false) // true untuk curah (kg, liter)
  price        Int // harga jual per unit, rupiah
  costPrice    Int             @default(0) // harga modal per unit, rupiah
  stockMode  StockMode @default(DIRECT)  // gantikan trackStock
  isSellable Boolean   @default(true)
  stockQty     Decimal         @default(0) @db.Decimal(14, 3) // cache; sumber kebenaran = StockMovement
  minStock     Decimal?        @db.Decimal(14, 3) // batas peringatan stok menipis
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  store        Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems    SaleItem[]
  priceTiers   VariantPriceTier[]
  recipeLines RecipeItem[] @relation("MenuRecipe")       // bahan yang dipakai menu ini
  usedIn      RecipeItem[] @relation("IngredientUsage")
  movements    StockMovement[]
  purchaseItems PurchaseItem[]
  units        ProductVariantUnit[]
  countItems   StockCountItem[]

  @@unique([storeId, sku])
  @@unique([storeId, barcode])
  @@index([storeId, isActive])
  @@index([productId])
}

model RecipeItem {
  id                  String         @id @default(cuid())
  storeId             String
  menuVariantId       String
  ingredientVariantId String
  qty                 Decimal        @db.Decimal(14, 3) // dalam satuan dasar bahan, per 1 porsi menu
  createdAt           DateTime       @default(now())
  store               Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  menu                ProductVariant @relation("MenuRecipe", fields: [menuVariantId], references: [id], onDelete: Cascade)
  ingredient          ProductVariant @relation("IngredientUsage", fields: [ingredientVariantId], references: [id], onDelete: Restrict)

  @@unique([menuVariantId, ingredientVariantId])
  @@index([storeId])
  @@index([ingredientVariantId])
}

model StockMovement {
  id           String            @id @default(cuid())
  storeId      String
  variantId    String
  type         StockMovementType
  qty          Decimal           @db.Decimal(14, 3)
  balanceAfter Decimal           @db.Decimal(14, 3) // stok setelah perubahan ini
  saleId       String?
  purchaseId   String?
  note         String?
  createdById  String?
  createdAt    DateTime          @default(now())
  store        Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant      ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  sale         Sale?             @relation(fields: [saleId], references: [id], onDelete: SetNull)
  purchase     Purchase?         @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  createdBy    User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  saleReturnId String?
  saleReturn   SaleReturn? @relation(fields: [saleReturnId], references: [id], onDelete: SetNull)

  @@index([saleReturnId])
  @@index([storeId, variantId, createdAt])
  @@index([saleId])
  @@index([purchaseId])
}

model Sale {
  id             String         @id @default(cuid())
  storeId        String
  receiptNo      Int // berurutan per toko, dari Store.receiptCounter
  status         SaleStatus     @default(COMPLETED)
  cashierId      String?
  customerName   String? // nama pembeli bebas (non-bon)
  customerId     String? // wajib untuk paymentMethod CREDIT
  subtotal       Int
  discount       Int            @default(0)
  total          Int
  amountPaid     Int
  changeAmount   Int            @default(0)
  creditAmount   Int            @default(0)
  note           String?
  idempotencyKey String // dibuat client; cegah transaksi dobel saat retry
  voidedAt       DateTime?
  voidReason     String?
  voidedById     String?
  createdAt      DateTime       @default(now())
  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cashier        User?          @relation("SaleCashier", fields: [cashierId], references: [id], onDelete: SetNull)
  voidedBy       User?          @relation("SaleVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items          SaleItem[]
  movements      StockMovement[]
  paymentLines   SalePayment[]
  returns        SaleReturn[]

  @@unique([storeId, receiptNo])
  @@unique([storeId, idempotencyKey])
  @@index([storeId, createdAt])
  @@index([storeId, status, createdAt])
  @@index([storeId, customerId])
}

model SaleItem {
  id          String          @id @default(cuid())
  saleId      String
  variantId   String?
  productName String // snapshot
  variantName String // snapshot
  unit        String // snapshot
  qty         Decimal         @db.Decimal(14, 3)
  price       Int // snapshot harga jual per unit
  costPrice   Int // snapshot harga modal per unit
  lineTotal   Int // round(price * qty)
  costTotal   Int // round(costPrice * qty), untuk hitung laba
  sale        Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  returnItems SaleReturnItem[]
  @@index([saleId])
  @@index([variantId])
}

model Supplier {
  id        String     @id @default(cuid())
  storeId   String
  name      String
  phone     String?
  createdAt DateTime   @default(now())
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@unique([storeId, name])
  @@index([storeId])
}

model Purchase {
  id          String          @id @default(cuid())
  storeId     String
  supplierId  String?
  invoiceNo   String?
  note        String?
  total       Int
  purchasedAt DateTime        @default(now())
  createdById String?
  createdAt   DateTime        @default(now())
  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier    Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items       PurchaseItem[]
  movements   StockMovement[]

  @@index([storeId, purchasedAt])
}

model PurchaseItem {
  id         String         @id @default(cuid())
  purchaseId String
  variantId  String
  unitName   String // satuan yang dipakai saat beli (snapshot), contoh: karung
  unitFactor Decimal        @db.Decimal(14, 3) // snapshot: satuan dasar per 1 satuan beli
  qtyInput   Decimal        @db.Decimal(14, 3) // jumlah dalam satuan beli
  unitCost   Int // harga per satuan beli
  qty        Decimal        @db.Decimal(14, 3) // jumlah dalam SATUAN DASAR (yang masuk ke stok)
  costPrice  Int // harga modal per satuan dasar pada pembelian ini
  lineTotal  Int
  purchase   Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([variantId])
}

model Expense {
  id          String   @id @default(cuid())
  storeId     String
  category    String
  amount      Int
  note        String?
  spentAt     DateTime @default(now())
  createdById String?
  createdAt   DateTime @default(now())
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([storeId, spentAt])
}

model ProductVariantUnit {
  id        String         @id @default(cuid())
  storeId   String
  variantId String
  name      String // karung, dus, lusin, dst.
  factor    Decimal        @db.Decimal(14, 3) // jumlah satuan dasar per 1 satuan ini
  createdAt DateTime       @default(now())
  store     Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, name])
  @@index([storeId])
}

model Customer {
  id          String            @id @default(cuid())
  storeId     String
  name        String
  phone       String?
  note        String?
  creditLimit Int? // batas bon; null = tanpa batas
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sales       Sale[]
  payments    CustomerPayment[]
  returns SaleReturn[]

  @@index([storeId, name])
}

model CustomerPayment {
  id          String        @id @default(cuid())
  storeId     String
  customerId  String
  amount      Int
  method      PaymentMethod // CASH / QRIS / TRANSFER / OTHER (bukan CREDIT)
  note        String?
  createdById String? // id user pencatat (tanpa FK)
  voidedAt    DateTime?
  createdAt   DateTime      @default(now())
  store       Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  voidedById  String?
  voidReason  String?
  
  @@index([storeId, createdAt])
  @@index([customerId])
}

model CashShift {
  id           String         @id @default(cuid())
  storeId      String
  openStoreId  String?        @unique
  status       ShiftStatus    @default(OPEN)
  openedById   String? // id user (tanpa FK)
  openedAt     DateTime       @default(now())
  openingCash  Int
  closedById   String?
  closedAt     DateTime?
  expectedCash Int? // snapshot saat ditutup
  countedCash  Int? // hasil hitung fisik
  difference   Int? // countedCash - expectedCash
  note         String?
  store        Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  movements    CashMovement[]

  @@index([storeId, openedAt])
}

model CashMovement {
  id          String           @id @default(cuid())
  storeId     String
  shiftId     String
  type        CashMovementType
  amount      Int
  note        String
  saleReturnId String? @unique // refund tunai tercatat sebagai OUT
  saleReturn   SaleReturn? @relation(fields: [saleReturnId], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime         @default(now())
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shift       CashShift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
}

model StockCount {
  id          String           @id @default(cuid())
  storeId     String
  status      StockCountStatus @default(DRAFT)
  note        String?
  createdById String?
  createdAt   DateTime         @default(now())
  completedAt DateTime?
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items       StockCountItem[]

  @@index([storeId, createdAt])
}

model StockCountItem {
  id        String         @id @default(cuid())
  countId   String
  variantId String
  counted   Decimal?       @db.Decimal(14, 3) // hitungan fisik (null = belum dihitung)
  systemQty Decimal?       @db.Decimal(14, 3) // stok sistem saat disahkan
  diffQty   Decimal?       @db.Decimal(14, 3) // counted - systemQty
  costPrice Int            @default(0) // snapshot harga modal saat disahkan
  count     StockCount     @relation(fields: [countId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([countId, variantId])
  @@index([variantId])
}

model VariantPriceTier {
  id        String         @id @default(cuid())
  storeId   String
  variantId String
  minQty    Decimal        @db.Decimal(14, 3) // dalam satuan dasar
  price     Int            
  createdAt DateTime       @default(now())
  store     Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, minQty])
  @@index([storeId])
}

enum RefundMethod {
  CASH
  QRIS
  TRANSFER
  OTHER
  CREDIT_OFFSET
}

model SalePayment {
  id        String        @id @default(cuid())
  storeId   String
  saleId    String
  method    PaymentMethod
  amount    Int // bagian dari total yang dilunasi lewat metode ini, TANPA kembalian
  reference String? // no. referensi QRIS/transfer
  createdAt DateTime      @default(now())
  store     Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([storeId, method, createdAt])
}

model SaleReturn {
  id           String           @id @default(cuid())
  storeId      String
  saleId       String
  returnNo     Int // berurutan per toko, dari Store.returnCounter
  customerId   String?
  total        Int // nilai barang yang diretur
  refundMethod RefundMethod
  refundAmount Int              @default(0) // uang yang keluar
  creditOffset Int              @default(0) // bagian yang memotong bon
  reason       String?
  createdById  String?
  createdAt    DateTime         @default(now())
  store        Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sale         Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items        SaleReturnItem[]
  movements    StockMovement[]
  cashMovement CashMovement?

  @@unique([storeId, returnNo])
  @@index([storeId, createdAt])
  @@index([saleId])
}

model SaleReturnItem {
  id         String         @id @default(cuid())
  returnId   String
  saleItemId String
  variantId  String?
  qty        Decimal        @db.Decimal(14, 3)
  lineTotal  Int
  costTotal  Int // untuk membalik HPP di laporan laba
  restock    Boolean        @default(true) // false = rusak, stok tidak bertambah
  reason     String?
  return     SaleReturn     @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem   SaleItem       @relation(fields: [saleItemId], references: [id], onDelete: Restrict)

  @@index([returnId])
  @@index([saleItemId])
}

enum BusinessType {
  RETAIL
  FNB
  SERVICE
  OTHER
}